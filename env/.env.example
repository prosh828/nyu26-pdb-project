# (선택) 기본값을 바꾸고 싶을 때만: cp env/.env.example env/.env 후 수정
# .env 는 git에 올리지 않습니다. 없으면 아래 기본값이 그대로 쓰입니다.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
# db/init SQL 이 `USE recco` 를 쓰므로 MYSQL_DATABASE 는 바꾸지 마세요
MYSQL_DATABASE=recco
MYSQL_USER=recco
MYSQL_PASSWORD=reccopass

# --- Flask ---
FLASK_SECRET_KEY=dev-secret
TMDB_API_KEY=

# --- 앱 시작 시 자동 생성되는 관리자 계정 ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@recco.local
ADMIN_PASSWORD=admin1234

# --- 호스트 포트 (충돌 시 변경) ---
DB_HOST_PORT=3307
APP_HOST_PORT=5001
ADMINER_HOST_PORT=8081
